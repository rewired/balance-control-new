{
    "name":  "@bc/server",
    "version":  "0.0.0",
    "type":  "module",
    "main":  "dist/src/index.js",
    "types":  "dist/src/index.d.ts",
    "imports": {
        "#boardgame-client": {
            "types": "boardgame.io/dist/types/packages/client.js",
            "node": "boardgame.io/dist/cjs/client.js",
            "default": "boardgame.io/client"
        },
        "#boardgame-server": {
            "types": "boardgame.io/dist/types/packages/server.js",
            "node": "boardgame.io/dist/cjs/server.js",
            "default": "boardgame.io/server"
        }
    },
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "bot:run":  "tsx src/bot.runner.ts",
                    "build":  "tsc -b",
                    "lint":  "eslint src --ext .ts",
                    "test":  "vitest run",
                    "dev":  "node --no-experimental-require-module --import tsx --watch src/index.ts"
                },
    "dependencies":  {
                         "@bc/game":  "workspace:*",
                         "@bc/shared":  "workspace:*",
                         "boardgame.io":  "^0.50.2",
                         "@bc/bot-llm":  "workspace:*",
                         "koa-body": "5.0.0"
                     },
    "devDependencies":  {
                            "eslint":  "^8.57.1",
                            "tsx":  "^4.21.0",
                            "typescript":  "^5.9.3",
                            "vitest":  "^1.6.1"
                        }
}
